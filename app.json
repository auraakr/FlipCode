{
  "expo": {
    "name": "FlipCode",
    "slug": "flipcode",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#1F4E9E"
      },
      "package": "com.flipcode.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "FlipCode memerlukan kamera untuk mengambil foto profil.",
          "photosPermission": "FlipCode memerlukan akses galeri untuk memilih foto profil."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "61a79a8b-e25d-42c7-b637-3a8f05fe278c"
      }
    },
    "owner": "auraakrs-team"
  }
}
