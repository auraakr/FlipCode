# Alamat server API. Boleh dikosongkan saat development: aplikasi menebak otomatis
# (IP laptop dari Expo, atau 10.0.2.2 di emulator Android, atau localhost di web).
# Isi saat server sudah di-deploy, atau kalau tebakan otomatis salah.
# Salin file ini menjadi .env lalu isi, kemudian jalankan ulang `npx expo start -c`.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
